# EditorConfig configuration for Rysoo Monorepo
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.java]
indent_size = 4

[*.{kt,kts}]
indent_size = 4

[*.{ts,tsx,js,jsx,json,css,scss,html,yaml,yml,md}]
indent_size = 2

[Makefile]
indent_style = tab
