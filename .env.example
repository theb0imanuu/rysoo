# ==============================================================================
# RYSOO PLATFORM ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Boot Backend & Persistence (apps/api & apps/worker)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Supabase PostgreSQL JDBC connection string
# Production format: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# ------------------------------------------------------------------------------
# 2. Supabase Auth & JWT Validation (Option A Security)
# ------------------------------------------------------------------------------
# Project URL e.g. https://xyzcompany.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# JWT Issuer matching token 'iss' claim
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
# Public JWKS endpoint for asymmetric signature validation (RS256 / ES256)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
# Private Supabase service role key (NEVER expose to frontend or mobile)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# ------------------------------------------------------------------------------
# 3. Supabase Private Storage Buckets
# ------------------------------------------------------------------------------
SUPABASE_STORAGE_BUCKET=cv-documents

# ------------------------------------------------------------------------------
# 4. AI Provider Integration (Provider-Agnostic Interface)
# ------------------------------------------------------------------------------
# Options: openai | anthropic | gemini | mock
AI_PRIMARY_PROVIDER=mock
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# 5. CORS Allowed Origins (Comma-separated)
# ------------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://rysoo.vercel.app

# ------------------------------------------------------------------------------
# 6. React Web Application (apps/web)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_supabase_anon_key
VITE_API_BASE_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# 7. React Native Mobile App (apps/mobile)
# ------------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_public_supabase_anon_key
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# ------------------------------------------------------------------------------
# 8. GitHub Actions CI/CD Secrets (Repository Secrets Checklist)
# ------------------------------------------------------------------------------
# RENDER_API_DEPLOY_HOOK_URL: Webhook URL from Render API Service settings
# RENDER_WORKER_DEPLOY_HOOK_URL: Webhook URL from Render Worker Service settings
# VERCEL_TOKEN: Personal Access Token from Vercel account
# VERCEL_ORG_ID: Organization ID from Vercel project settings
# VERCEL_PROJECT_ID: Project ID from Vercel project settings
